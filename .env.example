# ==============================================================================
# ORBIT BLR 3.2 — Environment Configuration Template (.env.example)
#
# Copy this file to .env.local for local development.
# Configure corresponding environment variables in Vercel Project Settings for production.
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit .env or .env.local to version control.
# 2. NEVER prefix private credentials with NEXT_PUBLIC_. Only NEXT_PUBLIC_APP_URL is public.
# 3. In production, AUTH_SECRET must be set to a cryptographically random 32+ byte string.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application URL & Canonical Domain
# ------------------------------------------------------------------------------
# Local: http://localhost:3000
# Production: https://orbit-blr.vercel.app
NEXT_PUBLIC_APP_URL=https://orbit-blr.vercel.app

# ------------------------------------------------------------------------------
# 2. Database Connection (Neon PostgreSQL)
# ------------------------------------------------------------------------------
# PostgreSQL pooled connection string for Neon project (e.g., broad-tooth-55681211).
# SQLite fallback in data/orbit.db is used automatically when DATABASE_URL is not set.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-broad-tooth-55681211.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 3. NextAuth / Auth.js v5 Core Secret
# ------------------------------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32 (or: npx auth secret)
AUTH_SECRET=your_32_byte_random_auth_secret_here

# ------------------------------------------------------------------------------
# 4. GitHub OAuth Provider Credentials (Primary Authentication)
# ------------------------------------------------------------------------------
# Created in GitHub Settings > Developer settings > OAuth Apps > New OAuth App
# Homepage URL:
#   - Local: http://localhost:3000
#   - Production: https://orbit-blr.vercel.app
# Authorization callback URL:
#   - Local: http://localhost:3000/api/auth/callback/github
#   - Production: https://orbit-blr.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret
#   - Local: http://localhost:3000
#   - Production: https://orbit-blr.vercel.app
# Authorization callback URL:
#   - Local: http://localhost:3000/api/auth/callback/github
#   - Production: https://orbit-blr.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID=your_github_oauth_client_id
AUTH_GITHUB_SECRET=your_github_oauth_client_secret

# ------------------------------------------------------------------------------
# 6. Orbit Automated Event Ingestion & Sync Secret
# ------------------------------------------------------------------------------
# Secret token for authorized automated event scraping, ingest pipelines, and
# hourly publishing workflows.
ORBIT_API_SECRET=your_secure_random_api_secret_token_here

# ------------------------------------------------------------------------------
# 7. Orbit Sensitive Registered User Statistics Secret
# ------------------------------------------------------------------------------
# Dedicated secret token strictly for querying private registered user counts
# and community member statistics (/api/stats/users).
# Kept separate from event ingestion to enforce the principle of least privilege.
# Provide via: Authorization: Bearer <ORBIT_STATS_SECRET> or header x-orbit-stats-key.
ORBIT_STATS_SECRET=your_secure_random_stats_secret_token_here

# ------------------------------------------------------------------------------
# 8. Vercel Web Analytics
# ------------------------------------------------------------------------------
# Enabled automatically via @vercel/analytics/react.
# No manual API key required; Vercel injects telemetry during production builds.
