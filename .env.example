# Orbit BLR Environment Configuration Template

# Admin dashboard login password (use a strong random secret)
ORBIT_ADMIN_PASSWORD=your_secure_admin_password_here

# Secure API secret token for authorized AI / ChatGPT updates & automated imports
ORBIT_API_SECRET=your_secure_api_secret_token_here

# Base URL for metadata and absolute links
NEXT_PUBLIC_APP_URL=https://your-domain.com

# PostgreSQL / Supabase / Neon connection string (required for production)
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require
